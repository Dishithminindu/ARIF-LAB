# ARIF Laboratory Inventory & Reservation System Configuration

# Application Port (Platform hardcoded to 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# CRITICAL SECURITY NOTICE:
# JWT_SECRET is a private, server-only secret key used exclusively on the Node.js backend
# to cryptographically sign session tokens. It must NEVER be exposed to browser JavaScript,
# must NEVER be prefixed with VITE_, and must NEVER be committed to version control.
JWT_SECRET=

# JWT Token Expiry (e.g. 7d, 24h)
JWT_EXPIRY=7d

# Initial Administrator Setup Credentials (Used for automatic database seeding if no admin exists)
ADMIN_INITIAL_EMAIL=admin@ariflab.edu
ADMIN_INITIAL_PASSWORD=Admin@ARIF2026!
ADMIN_INITIAL_NAME=ARIF Lab Administrator
ADMIN_INITIAL_STUDENT_ID=ADM-001

# System Security Configuration
ENABLE_RATE_LIMIT=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
